# 复制为 .env 后按需修改；.env 已被 Git 忽略，绝不能提交真实密钥。
APP_MODE=local
FRONTEND_PORT=3030
API_PORT=8030
MCP_PORT=9030

# MongoDB 单节点 replica set（compose.yaml）
MONGODB_URI=mongodb://127.0.0.1:27027/?replicaSet=ta-rs&directConnection=true
MONGODB_DATABASE=technologyagent_dev

# P00 不实现模型调用；MODEL_MODE=fake 时仍标记为 disabled。配置了api后改为live
MODEL_MODE=fake
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=
MODEL_API_KEY=

# localhost 开发会话；生产部署的身份认证是 P09 前条件。
LOCAL_SESSION_SECRET=replace-with-a-long-random-local-secret
SESSION_TTL_HOURS=24
STORAGE_ROOT=storage

# 可选：读取本项目中的用户库存快照，详见 data/README.md
# INVENTORY_DATA_SOURCE=local_snapshot
# PARTS_DATA_SOURCE=local_snapshot
# INVENTORY_SNAPSHOT_PATH=data/inventory_snapshot.json
